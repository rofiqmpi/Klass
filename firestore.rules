rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null && request.auth.token.email != null;
    }

    function authEmail() {
      return request.auth.token.email.lower();
    }

    function isOwner(docId) {
      return isAuthenticated() && authEmail() == docId.lower();
    }

    function isApprovedAdmin() {
      return isAuthenticated() && (
        authEmail() == 'mdrofiqmpi@gmail.com' ||
        (
          exists(/databases/$(database)/documents/admins/$(authEmail())) &&
          get(/databases/$(database)/documents/admins/$(authEmail())).data.get('status', 'APPROVED') == 'APPROVED'
        )
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 160;
    }

    function isValidConnection(data) {
      return data.keys().hasAll(['id', 'participants', 'requester_email', 'receiver_email', 'status', 'updated_at']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 160 &&
             data.participants is list && data.participants.size() == 2 &&
             data.requester_email is string && data.requester_email.size() > 0 && data.requester_email.size() <= 160 &&
             data.receiver_email is string && data.receiver_email.size() > 0 && data.receiver_email.size() <= 160 &&
             data.status in ['PENDING', 'ACCEPTED'] &&
             data.updated_at is int;
    }

    function isValidChatRelay(data) {
      return data.keys().hasAll(['id', 'sender_email', 'receiver_email', 'text', 'sent_at']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 160 &&
             data.sender_email is string && data.sender_email.size() > 0 && data.sender_email.size() <= 160 &&
             data.receiver_email is string && data.receiver_email.size() > 0 && data.receiver_email.size() <= 160 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 2000 &&
             data.sent_at is int;
    }

    // Default deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Config collection: public sign-in switches & dictionary read; admin-only mutation
    match /config/{configId} {
      allow read: if configId in ['signin_control', 'language_dictionary'] || isAuthenticated();
      allow create: if isApprovedAdmin() || (isAuthenticated() && configId != 'signin_control');
      allow update, delete: if isApprovedAdmin();
    }

    // Admins collection: zero-trust self-request (PENDING only) and admin approval
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow create: if isApprovedAdmin() ||
        (isOwner(adminId) && request.resource.data.get('status', 'PENDING') == 'PENDING');
      allow update: if isApprovedAdmin() ||
        (isOwner(adminId) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'role']) ||
          request.resource.data.get('status', 'PENDING') == resource.data.get('status', 'PENDING')
        ));
      allow delete: if isApprovedAdmin() || isOwner(adminId);
    }

    // Legacy admin lookup collection
    match /admin/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isApprovedAdmin();
    }

    // Teachers collection: directory read for authenticated users; owner or admin write
    match /teachers/{teacherId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isOwner(teacherId) || isApprovedAdmin();
    }

    // Students collection: directory/blood read for authenticated users; owner or admin write
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isOwner(studentId) || isApprovedAdmin();
    }

    // General users collection: profile/directory read for authenticated users; owner or admin write
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isOwner(userId) || isApprovedAdmin();
    }

    // Books library collection
    match /books/{bookId} {
      allow read: if isAuthenticated();
      allow create: if isApprovedAdmin() || (isAuthenticated() && bookId.matches('^bteb_.*'));
      allow update, delete: if isApprovedAdmin();
    }

    // Classrooms & Labs collection (needed by Guest & signed-in schedule views)
    match /classrooms/{roomId} {
      allow read: if true;
      allow write: if isApprovedAdmin();
    }

    // Generated & Published Class Routines collection
    match /routines/{routineId} {
      allow read: if routineId == 'master_6m_published' || isAuthenticated();
      allow write: if isApprovedAdmin();
    }

    // Teacher manual edit/swap requests collection
    match /routine_edit_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.get('requested_by_email', '').lower() == authEmail() &&
        request.resource.data.get('status', 'PENDING') == 'PENDING';
      allow update: if isApprovedAdmin();
      allow delete: if isApprovedAdmin() ||
        (isAuthenticated() && resource.data.get('requested_by_email', '').lower() == authEmail());
    }

    // App notifications & announcements collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isApprovedAdmin();
    }

    // Friend connections collection (participant-only isolation + receiver-only accept)
    match /connections/{connectionId} {
      allow get: if isAuthenticated() && isValidId(connectionId) &&
        (resource == null || authEmail() in resource.data.participants);
      allow list: if isAuthenticated() && authEmail() in resource.data.participants;
      allow create: if isAuthenticated() && isValidId(connectionId) &&
        isValidConnection(request.resource.data) &&
        request.resource.data.id == connectionId &&
        request.resource.data.requester_email == authEmail() &&
        authEmail() in request.resource.data.participants &&
        request.resource.data.receiver_email != authEmail() &&
        request.resource.data.receiver_email in request.resource.data.participants &&
        request.resource.data.status == 'PENDING';
      allow update: if isAuthenticated() && isValidId(connectionId) &&
        isValidConnection(request.resource.data) &&
        authEmail() in resource.data.participants &&
        authEmail() == resource.data.receiver_email.lower() &&
        resource.data.status == 'PENDING' &&
        request.resource.data.status == 'ACCEPTED' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at']);
      allow delete: if isAuthenticated() && isValidId(connectionId) &&
        (authEmail() in resource.data.participants || isApprovedAdmin());
    }

    // Zero-retention ephemeral direct message relay (sender/receiver only; recipient reads then deletes)
    match /chat_relay/{messageId} {
      allow get: if isAuthenticated() && isValidId(messageId) &&
        (resource == null ||
         resource.data.receiver_email == authEmail() ||
         resource.data.sender_email == authEmail());
      allow list: if isAuthenticated() &&
        (resource.data.receiver_email == authEmail() ||
         resource.data.sender_email == authEmail());
      allow create: if isAuthenticated() && isValidId(messageId) &&
        isValidChatRelay(request.resource.data) &&
        request.resource.data.id == messageId &&
        request.resource.data.sender_email == authEmail() &&
        request.resource.data.receiver_email != authEmail();
      allow update: if false;
      allow delete: if isAuthenticated() && isValidId(messageId) &&
        (resource.data.receiver_email == authEmail() ||
         resource.data.sender_email == authEmail());
    }
  }
}

