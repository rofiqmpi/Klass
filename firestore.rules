rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Config collection:
    // Everyone can read, only Admins (checked via token email or custom doc check) can write.
    // For simplicity here, allowing authenticated users to read config.
    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Should ideally be Admin-only, but keeping flexible for now as admin check is complex in rules without a custom claim
    }

    // Admins collection:
    match /admins/{adminId} {
      allow read, write: if isAuthenticated();
    }

    // Teachers collection:
    match /teachers/{teacherId} {
      allow read, write: if isAuthenticated();
    }

    // Students collection:
    match /students/{studentId} {
      allow read, write: if isAuthenticated();
    }

    // General users collection
    match /users/{userId}/{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
