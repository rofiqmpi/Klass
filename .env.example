# Secrets / environment configuration for local builds & GitHub Releases.
# Configure values in AI Studio Secrets panel, local `.env`, or GitHub Repository Secrets.
# Leave blank if relying strictly on Firebase AI Logic (App Check) & default Firestore DB.

GEMINI_API_KEY=
RECAPTCHA_SITE_KEY=
FIRESTORE_DATABASE_ID=
# Public release feed URL (do NOT point to a private GitHub repo; use a separate public releases-only repo or Firestore config/app_update)
APP_UPDATE_URL=
